{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "counter-timer",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "REST_ALARM", "class_name": "RestAlarm" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RestAlarm"] }]
  // Secrets (kept out of this file so the repo can be public):
  //   VAPID_PUBLIC_KEY, VAPID_PRIVATE_JWK — push keys (npm run vapid)
  //   VAPID_SUBJECT — mailto: contact address for push services
  // Locally they come from .dev.vars; in production, `npx wrangler secret put <NAME>`.
}
